{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "snapshot": false,
  "default_agent": "plan",
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      "documents/**",
      ".cache/**",
      ".local/**",
      ".mozilla/**"
    ]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "allow",
      "/home/marcos/.config/hypr/**": "ask",
      "/home/marcos/.config/omarchy/**": "ask",
      "/home/marcos/.config/ghostty/**": "ask",
      "/usr/share/omarchy/**": "deny"
    },
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "doom_loop": "ask",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git commit": "ask",
      "git commit *": "ask",
      "su *": "deny",
      "doas *": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "kill *": "ask",
      "pkill *": "ask",
      ": > *": "deny"
    }
  }
}
